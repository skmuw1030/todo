<h3>新しいスケジュール作成</h3>

<%= form_with model: @schedule do |f| %>
  <div>
    <p>タイトル<span>*</span></p>
    <%= f.text_field :title %>
      <% if @schedule.errors[:title].any? %>
        <div class="error">
          <%= @schedule.errors.full_messages_for(:title).first %>
        </div>
      <% end %>
  </div>
  <div>
    <p>開始日<span>*</span></p>
    <%= f.date_field :start_date %>
      <% if @schedule.errors[:start_date].any? %>
        <div class="error">
          <%= @schedule.errors.full_messages_for(:start_date).first %>
        </div>
      <% end %>
  </div>
  <div>
    <p>終了日<span>*</span></p>
    <%= f.date_field :end_date %>
      <% if @schedule.errors[:end_date].any? %>
        <div class="error">
          <%= @schedule.errors.full_messages_for(:end_date).first %>
        </div>
      <% end %>
  </div>
  <p><%= f.check_box :all_day %>終日の場合はチェックします。</p>
  <div>
    <p>メモ</p>
    <%= f.text_area :memo %>
      <% if @schedule.errors[:memo].any? %>
        <div class="error">
          <%= @schedule.errors.full_messages_for(:memo).first %>
        </div>
      <% end %>
  </div>
  <p><%= f.submit "登録" %></p>
  <p><%= link_to "キャンセル", schedules_path %></p>
<% end %>
