<div class="container d-flex justify-content-center mt-5">
  <div class="row justify-content-center w-100">
    <div class="col-lg-6">
      
      <h3 class="fw-bold fs-6 text-start mb-4">予定を編集してください</h3>

      <%= form_with model: @schedule do |f| %>
        <div class="mb-4">
          <p class="mb-2 fw-bold">タイトル<span class="text-danger">*</span></p>
          <%= f.text_field :title, maxlength:20, class:"form-control w-100 mx-auto d-block rounded-1" ,placeholder: "タイトル",id:"title-field" %>
          <div class="text-end mt-1">
            <small id="title-count">0 / 20</small>
          </div>

          <% if @schedule.errors[:title].any? %>
            <div class="text-danger">
              <%= @schedule.errors.full_messages_for(:title).first %>
            </div>
          <% end %>
        </div>

        <div class="row">
          <div class="col-md-6">
            <p class="mb-2 fw-bold">開始日<span class="text-danger">*</span></p>
            <%= f.date_field :start_date, class:"form-control" %>
            <% if @schedule.errors[:start_date].any? %>
              <div class="text-danger mt-1">
                <%= @schedule.errors.full_messages_for(:start_date).first %>
              </div>
            <% end %>
          </div>
          <div class="col-md-6">
            <p class="mb-2 fw-bold">終了日<span class="text-danger">*</span></p>
            <%= f.date_field :end_date, class:"form-control"%>
            <% if @schedule.errors[:end_date].any? %>
              <div class="text-danger mt-1">
                <%= @schedule.errors.full_messages_for(:end_date).first %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="form-check mt-3">
          <%= f.check_box :all_day,class:"form-check-input form-check-input-lg me-2" %>終日の場合はチェックします。
        </div>

        <div class="mb-4 mt-4">
          <p class="fw-bold mb-2">メモ</p>
          <%= f.text_area :memo, maxlength: 500,class:"form-control",placeholder:"メモを入力する",rows: 8,id:"memo-field" %>
          <div class="text-end mt-1">
            <small id="memo-count">0 / 500</small>
          </div>
        
          <% if @schedule.errors[:memo].any? %>
            <div class="text-danger mt-1">
              <%= @schedule.errors.full_messages_for(:memo).first %>
            </div>
          <% end %>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
          <%= link_to schedules_path, class: "btn btn-outline-secondary px-3 py-2" do %>
            <i class="bi bi-arrow-bar-left"></i> キャンセル
          <% end %>
          <%= button_tag type: "submit", class:"btn btn-primary d-flex align-items-center gap-2 px-3 py-2 rounded-3" do %>
            <i class="bi bi-check-circle"></i>更新
          <% end %>
        </div>

      <% end %>

    </div>
  </div>
</div>
